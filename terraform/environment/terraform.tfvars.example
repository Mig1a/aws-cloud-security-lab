# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
# Every value below has a working default - this file exists to document them.

# aws_region         = "us-east-1"
# project_name       = "cloudsec-lab"
# vpc_cidr           = "10.0.0.0/16"
# public_subnet_cidr = "10.0.1.0/24"
# instance_type      = "t3.micro"
# log_retention_days = 30

# SSH is off by default; use Session Manager instead:
#   aws ssm start-session --target <instance-id>
#
# If an exercise needs SSH, set both, and scope the CIDR to your own address:
# enable_ssh       = true
# allowed_ssh_cidr = "203.0.113.4/32"
